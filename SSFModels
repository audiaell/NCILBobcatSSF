plot_male_selection_step_crossing <- function(model, data, season_label,
                                              age_levels = c("Adult", "Juvenile"),
                                              dist_seq = NULL) {
  
  
  if (is.null(dist_seq)) {
    dist_seq <- seq(
      quantile(data$dist, 0.05, na.rm = TRUE),
      quantile(data$dist, 0.95, na.rm = TRUE),
      length.out = 100
    )
  }
  
  plot_dat_list <- list()
  
  for (age_val in age_levels) {
    
    data_age <- data %>% filter(age == age_val)
    if (nrow(data_age) == 0) next
    
    newdat <- data.frame(
      dist = dist_seq,
      forest = mean(data_age$forest, na.rm = TRUE),
      forest_grass = mean(data_age$forest_grass, na.rm = TRUE),
      forest_crop = mean(data_age$forest_crop, na.rm = TRUE),
      road_cross = 1,
      age = age_val
    )
    
    newdat$`log(dist)` <- log(newdat$dist)
    
    pred <- predict(
      model,
      newdata = newdat,
      type = "link",
      se.fit = TRUE,
      re.form = NA
    )
    
    plot_dat_list[[age_val]] <- newdat %>%
      mutate(
        eta = pred$fit,
        eta_se = pred$se.fit,
        lower = eta - 1.96 * eta_se,
        upper = eta + 1.96 * eta_se,
        age_class = age_val
      )
  }
  
  plot_dat <- bind_rows(plot_dat_list)
  
  ggplot(
    plot_dat,
    aes(x = dist, y = eta, color = age_class, fill = age_class)
  ) +
    geom_ribbon(aes(ymin = lower, ymax = upper),
                alpha = 0.15, color = NA) +
    geom_line(linewidth = 1.2) +
    labs(
      x = "Step length (m)",
      y = "Relative selection",
      color = "Age class",
      fill = "Age class"
    ) +
    scale_color_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    scale_fill_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    theme_classic(base_size = 18) +
    theme(
      text = element_text(color = "black"),
      legend.position = "none"
    )
}

p_male_ws_cross <- plot_male_selection_step_crossing(
  model = Male_ws_roads_models,
  data = submale_ws,
  season_label = "Winter/Spring"
)

