#####Subset Data #####

#load roads
roads<-st_read("DetailedRoads.shp")

# make sure CRS matches steps and have valid geometry
roads <- st_transform(roads, st_crs(ssf_lines_wCov))
roads <- st_make_valid(roads)
ssf_lines_wCov <- st_make_valid(ssf_lines_wCov)

#pull out used steps within 500 meters of roads
used_near_roads <- ssf_lines_wCov %>%
  filter(case == 1) %>%
  st_filter(roads, .predicate = st_is_within_distance, dist = 500)

#match random strata
valid_strata <- used_near_roads$strata
steps_subset <- ssf_lines_wCov %>%
  filter(strata %in% valid_strata)


#split by sex and period
submale_sf <- steps_subset %>%
  filter(period == "sf" & sex == "Male") %>%
  st_set_geometry(NULL)  # remove the geometry column


subfemale_sf <- steps_subset %>%
  filter(period == "sf" & sex == "Female") %>%
  st_set_geometry(NULL)


submale_ws <- steps_subset %>%
  filter(period == "ws" & sex == "Male") %>%
  st_set_geometry(NULL)


subfemale_ws <- steps_subset %>%
  filter(period == "ws" & sex == "Female") %>%
  st_set_geometry(NULL)


