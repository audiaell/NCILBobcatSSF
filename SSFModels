#
#### 2 - Landcover models
#

#function to fit models for all 4 datasets

fit_glmm_models <- function(dat) {
  models <- list(

    forest_gc_age = glmmTMB(case~-1+(forest+forest_grass+forest_crop+log(dist)+
                           log(dist):forest+log(dist):forest_grass+log(dist):forest_crop +
                           (1|strata)+
                           (0+forest|id:bobcatyear)+(0+forest_grass|id:bobcatyear)+(0+forest_crop|id:bobcatyear)):age,
                         family=poisson, data=dat,
                         map=list(theta=factor(c(NA,1:3))),
                         start=list(theta=c(log(1e3),0,0,0)))
  )
  
}


datasets <- list(
  mk = male_kitten,
  mb = male_breeding,
  fk = female_kitten,
  fb = female_breeding
)


#apply function to datasets
system.time(results_TMB <- lapply(datasets, fit_glmm_models)) 

mk_model<-results_TMB$mk$models$forest_gc_age
mb_model<-results_TMB$mb$models$forest_gc_age
fk_model<-results_TMB$fk$models$forest_gc_age
fb_model<-results_TMB$fb$models$forest_gc_age

summary(mb_model)
summary(mk_model)
summary(fb_model)
summary(fk_model)



#
#### 3 - Road Models ####
#

#load roads
roads<-st_read("DetailedRoads.shp")

# make sure CRS matches steps and have valid geometry
roads <- st_transform(roads, st_crs(ssf_lines_wCov))
roads <- st_make_valid(roads)
ssf_lines_wCov <- st_make_valid(ssf_lines_wCov)

#pull out used steps within 500 meters of roads
used_near_roads <- ssf_lines_wCov %>%
  filter(case == 1) %>%
  st_filter(roads, .predicate = st_is_within_distance, dist = 500)

#match random strata
valid_strata <- used_near_roads$strata
steps_subset <- ssf_lines_wCov %>%
  filter(strata %in% valid_strata)

#split by sex and period
submale_sf <- steps_subset %>%
  filter(season == "kitten" & sex == "Male") %>%
  st_set_geometry(NULL)  # remove the geometry column


subfemale_sf <- steps_subset %>%
  filter(season == "kitten" & sex == "Female") %>%
  st_set_geometry(NULL)


submale_ws <- steps_subset %>%
  filter(season == "breeding" & sex == "Male") %>%
  st_set_geometry(NULL)


subfemale_ws <- steps_subset %>%
  filter(season == "breeding" & sex == "Female") %>%
  st_set_geometry(NULL)


#Using landcover model, add road_cross and interactions with forest and log(dist)

#female summer/fall season
