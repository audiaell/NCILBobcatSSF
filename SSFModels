#function to fit models for all 4 datasets

fit_glmm_models <- function(dat) {
  models <- list(

    forest_gc_age = glmmTMB(case~-1+(forest+forest_grass+forest_crop+log(dist)+
                           log(dist):forest+log(dist):forest_grass+log(dist):forest_crop +
                           (1|strata)+
                           (0+forest|id)+(0+forest_grass|id)+(0+forest_crop|id)):age,
                         family=poisson, data=dat,
                         map=list(theta=factor(c(NA,1:3))),
                         start=list(theta=c(log(1e3),0,0,0)))
  )
  
  # return AICs (and keep models if you want them later)
  list(
    AIC = sapply(models, AIC),
    models = models
  )
}


