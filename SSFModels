plot_landcover_flexible <- function(model, data, habitat_var, age_col = "age",
                                    n_points = 100, dist_val = 1, landcover_name,
                                    age_line_types = c("Adult" = "solid", "Juvenile" = "dashed")) {
  
  vals <- seq(0, 1, length.out = n_points)
  age_levels <- unique(data[[age_col]])
  plot_dat_list <- list()
  
  for (age_class in age_levels) {
    data_age <- data %>% filter(!!sym(age_col) == age_class)
    if (nrow(data_age) == 0) next
    
    newdat <- data.frame(
      forest = mean(data_age$forest, na.rm = TRUE),
      forest_grass = mean(data_age$forest_grass, na.rm = TRUE),
      forest_crop = mean(data_age$forest_crop, na.rm = TRUE),
      dist = dist_val,
      age = age_class
    )
    
    newdat <- newdat[rep(1, n_points), ]
    newdat[[habitat_var]] <- vals
    newdat$`log(dist)` <- log(newdat$dist)
    
    pred <- predict(model, newdata = newdat, type = "link", se.fit = TRUE, re.form = NA)
    
    df <- newdat %>%
      mutate(
        eta = pred$fit,
        eta_se = pred$se.fit,
        lower = eta - 1.96 * eta_se,
        upper = eta + 1.96 * eta_se,
        age_class = age_class,
        # line_type = literal age class
        line_type = age_class
      )
    
    plot_dat_list[[age_class]] <- df
  }
  
  plot_dat <- bind_rows(plot_dat_list)
  plot_dat$age_class<-factor(plot_dat$age_class, levels = c("Juvenile", "Adult"))
  
  ggplot(plot_dat, aes_string(x = habitat_var, y = "eta", color = "age_class", linetype = "line_type")) +
    geom_ribbon(aes(ymin = lower, ymax = upper, fill = age_class), alpha = 0.5, color = NA) +
    geom_line(linewidth = 1.2) +
    labs(
      x = landcover_name,
      y = "Relative selection",
      color = "Age class",
      fill = "Age class",
      linetype = "Age class"
    ) +
    scale_color_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    scale_fill_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    # map the line type based on age
    scale_linetype_manual(values = age_line_types) +
    theme_classic(base_size = 24) +
    theme(text = element_text(color="black"),
          strip.background = element_blank(),
          legend.position = "none")
}

plot_step_flexible <- function(model, data, habitat_var, age_col = "age",
                               n_points = 100, landcover_name,yl,
                               age_line_types = c("Adult" = "solid",
                                                  "Juvenile" = "dashed")) {
  
  vals <- seq(0, 1, length.out = n_points)
  age_levels <- unique(data[[age_col]])
  plot_dat_list <- list()
  
  for (age_class in age_levels) {
    data_age <- data %>% filter(!!sym(age_col) == age_class)
    if (nrow(data_age) == 0) next
    
    newdat <- data.frame(
      forest = mean(data_age$forest, na.rm = TRUE),
      forest_grass = mean(data_age$forest_grass, na.rm = TRUE),
      forest_crop = mean(data_age$forest_crop, na.rm = TRUE),
      dist = mean(data_age$dist, na.rm = TRUE),
      age = age_class
    )
    
    newdat <- newdat[rep(1, n_points), ]
    newdat[[habitat_var]] <- vals
    newdat$`log(dist)` <- log(newdat$dist)
    
    pred <- predict(model, newdata = newdat, type = "link", se.fit = TRUE, re.form = NA)
    
    df <- newdat %>%
      mutate(
        eta = pred$fit,
        eta_se = pred$se.fit,
        lower_eta = eta - 1.96 * eta_se,
        upper_eta = eta + 1.96 * eta_se,
        step = exp(eta),
        step_lower = exp(lower_eta),
        step_upper = exp(upper_eta),
        age_class = age_class,
        line_type = age_class
      )
    
    plot_dat_list[[as.character(age_class)]] <- df
  }
  
  plot_dat <- bind_rows(plot_dat_list)
  plot_dat$age_class<-factor(plot_dat$age_class, levels = c("Juvenile", "Adult"))
  
  ggplot(plot_dat, aes_string(x = habitat_var, y = "step",
                              color = "age_class", linetype = "line_type")) +
    geom_ribbon(aes(ymin = step_lower, ymax = step_upper, fill = age_class),
                alpha = 0.50, color = NA) +
    geom_line(linewidth = 1.2) +
    labs(
      x = landcover_name,
      y = "Step length (m)",
      color = "Age class",
      fill = "Age class",
      linetype = "Age class"
    ) +
    scale_color_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    scale_fill_manual(values = c("Adult" = "#40B0A6", "Juvenile" = "#E1Be6A")) +
    scale_linetype_manual(values = age_line_types) +
    coord_cartesian(ylim = c(0,yl))+
    theme_classic(base_size = 24) +
    theme(
      text = element_text(color = "black"),
      strip.background = element_blank(),
      legend.position = "none"
    )
}


