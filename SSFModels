#set up libraries
library(glmmTMB)
library(tidyverse)
library(sf)
library(sp)

#read in data
ssf_lines_wCov<-readRDS("pub_data.rds")

#split by sex and season
male_sf <- ssf_lines_wCov %>%
  filter(period == "sf" & sex == "Male") %>%
  st_set_geometry(NULL)  # remove the geometry column

female_sf <- ssf_lines_wCov %>%
  filter(period == "sf" & sex == "Female") %>%
  st_set_geometry(NULL)

male_ws <- ssf_lines_wCov %>%
  filter(period == "ws" & sex == "Male") %>%
  st_set_geometry(NULL)

female_ws <- ssf_lines_wCov %>%
  filter(period == "ws" & sex == "Female") %>%
  st_set_geometry(NULL)




#
#### 2 - Select most parsimonious landcover models ####
#

#####function to fit models for all 4 datasets#####

fit_glmm_models <- function(dat) {
  
  models <- list(
    #null model
    null = glmmTMB(case~ (1|strata),
                   family=poisson, data=dat,
                   map=list(theta=factor(c(NA))), 
                   start=list(theta=c(log(1e3)))), #these lines specify the fixed variance for the strata random effect
    
    #model with just forest open edge
    forest_open = glmmTMB(case~-1+forest+forest_open+log(dist)+
                            forest:log(dist)+forest_open:log(dist)+
                            (1|strata)+
                            (0+forest|id)+(0+forest_open|id),
                          family=poisson, data=dat,
                          map=list(theta=factor(c(NA,1:2))),
                          start=list(theta=c(log(1e3),0,0))),
    
    #model with both forest-grassland and forest-crop edge
    forest_gc = glmmTMB(case~-1+forest+forest_grass+forest_crop+log(dist)+
                          forest:log(dist)+forest_grass:log(dist)+forest_crop:log(dist)+
                          (1|strata)+
                          (0+forest|id)+(0+forest_grass|id)+(0+forest_crop|id),
                        family=poisson, data=dat,
                        map=list(theta=factor(c(NA,1:3))),
                        start=list(theta=c(log(1e3),0,0,0)))
    
  )
  
  # return AICs (and keep models if you want them later)
  list(
    AIC = sapply(models, AIC),
    models = models
  )
}

#make a list of the datasets
datasets <- list(
  msf = male_sf,
  mws = male_ws,
  fsf = female_sf,
  fws = female_ws
)

#apply function to datasets
system.time(results_TMB <- lapply(datasets, fit_glmm_models)) 

#check AIC
AIC_table <- do.call(rbind, lapply(results_TMB, `[[`, "AIC"))
AIC_table

#pull out best models (lowest AIC)
best_models <- lapply(results_TMB, function(res) {
  best_name <- names(res$AIC)[which.min(res$AIC)]
  res$models[[best_name]]
})

#assign best model names
msf_model<-best_models$msf
mws_model<-best_models$mws
fsf_model<-best_models$fsf
fws_model<-best_models$fws



